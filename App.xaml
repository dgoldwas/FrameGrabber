<Application x:Class="FrameGrabber.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="PanelBrush" Color="#151B24" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1B2330" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDF2F7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8E9AAF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#76E4C4" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#163A39" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource PanelAltBrush}"/><Setter Property="BorderBrush" Value="#2A3545"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Margin" Value="0,10"/></Style>
  </Application.Resources>
</Application>
