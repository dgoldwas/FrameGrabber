<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrameGrabber</AssemblyName>
    <RootNamespace>FrameGrabber</RootNamespace>
    <Version>2026.09.23</Version>
    <ApplicationIcon>assets\FrameGrabber.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\FrameGrabber.ico" />
    <EmbeddedResource Include="$(FfmpegExe)" LogicalName="FrameGrabber.Tools.ffmpeg.exe" Condition="'$(FfmpegExe)' != ''" />
    <EmbeddedResource Include="$(FfprobeExe)" LogicalName="FrameGrabber.Tools.ffprobe.exe" Condition="'$(FfprobeExe)' != ''" />
  </ItemGroup>
</Project>
