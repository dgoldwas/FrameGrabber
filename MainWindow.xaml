<Window x:Class="FrameGrabber.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FrameGrabber" Width="1100" Height="740" MinWidth="900" MinHeight="620" Background="{StaticResource CanvasBrush}" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,26"><StackPanel DockPanel.Dock="Left"><TextBlock Text="FRAMEGRABBER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Precision stills from motion" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Margin="0,0,20,0" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="DropZone" Background="#111720" BorderBrush="#2D3A4B" BorderThickness="1" CornerRadius="10" AllowDrop="True"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" FontSize="42" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="Drop a video here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="MKV, MP4, MOV, WebM and more" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" HorizontalAlignment="Center"/><Button Content="Browse files" Click="Browse_Click"/></StackPanel><Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border>
    <Grid Grid.Row="1" Margin="4,18,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CurrentTimeText" Text="00:00:00.000" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/><Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged" PreviewMouseUp="Timeline_PreviewMouseUp"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00.000" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="2" Margin="4,14,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Jump to" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="TimeInput" Grid.Column="1" Text="00:00:00.000" Padding="8,6" Background="#10161F" Foreground="{StaticResource TextBrush}" BorderBrush="#2A3545" KeyDown="TimeInput_KeyDown"/><TextBlock Text="Enter a timecode and press Enter" Grid.Column="2" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/><Button x:Name="ExportButton" Grid.Column="3" Content="Export PNG  →" Background="{StaticResource AccentDarkBrush}" Foreground="{StaticResource AccentBrush}" Click="Export_Click" IsEnabled="False"/></Grid>
   </Grid></Border>
   <StackPanel Grid.Column="1"><TextBlock Text="VIDEO DETAILS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18"><StackPanel><TextBlock x:Name="FileNameText" Text="No video loaded" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="FilePathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/><WrapPanel><Border Background="#202B3A" CornerRadius="5" Padding="9,5" Margin="0,0,7,7"><TextBlock x:Name="ResolutionText" Text="Resolution —"/></Border><Border Background="#202B3A" CornerRadius="5" Padding="9,5" Margin="0,0,7,7"><TextBlock x:Name="CodecText" Text="Codec —"/></Border><Border Background="#202B3A" CornerRadius="5" Padding="9,5" Margin="0,0,7,7"><TextBlock x:Name="DepthText" Text="Color —"/></Border></WrapPanel><Border x:Name="HdrBadge" Background="#3A2C18" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="HdrText" Foreground="#FFCF76" FontWeight="SemiBold"/></Border><TextBlock x:Name="ColorText" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="EXPORT LOCATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,28,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14"><DockPanel><TextBlock x:Name="FolderText" Text="Pictures\FrameGrabber" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/><Button Content="Choose" DockPanel.Dock="Right" Click="Preferences_Click" Margin="10,0,0,0"/></DockPanel></Border></StackPanel>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready — drop a video to begin" Foreground="{StaticResource MutedBrush}" Margin="2,20,0,0"/>
 </Grid>
</Window>
