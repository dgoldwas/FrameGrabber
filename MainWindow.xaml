<Window x:Class="FrameGrabber.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FrameGrabber" Icon="/FrameGrabber;component/assets/FrameGrabber.ico" Width="1100" Height="860" MinWidth="900" MinHeight="700" Background="{StaticResource CanvasBrush}" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Grid Margin="32">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,26"><StackPanel><TextBlock Text="FRAMEGRABBER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Precision stills from motion" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Margin="0,0,20,0" Padding="18">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="DropZone" Background="#111720" BorderBrush="#2D3A4B" BorderThickness="1" CornerRadius="10"><Grid><StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" FontSize="42" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="Drop a video here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="MKV, MP4, MOV, WebM and more" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" HorizontalAlignment="Center"/><Button Content="Browse files" Click="Browse_Click"/></StackPanel><Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border>
     <Grid Grid.Row="1" Margin="4,18,4,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CurrentTimeText" Text="00:00:00.00" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/><Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged" PreviewMouseUp="Timeline_PreviewMouseUp"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00.00" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/><StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"><Button Content="−5 sec" Click="Rewind_Click" Padding="10,5" Margin="0,0,5,0"/><Button Content="−1 sec" Click="Rewind1_Click" Padding="10,5" Margin="0,0,12,0"/><Button Content="◀ Frame" Click="FrameBack_Click" Padding="10,5" Margin="0,0,5,0"/><Button Content="Frame ▶" Click="FrameForward_Click" Padding="10,5" Margin="0,0,12,0"/><Button Content="Chapter ◀" Click="ChapterBack_Click" Padding="10,5" Margin="0,0,5,0"/><ComboBox x:Name="ChapterPicker" Width="170" DisplayMemberPath="Title" SelectionChanged="ChapterPicker_SelectionChanged" Padding="4"/><Button Content="Chapter ▶" Click="ChapterForward_Click" Padding="10,5" Margin="5,0,12,0"/><Button Content="+1 sec" Click="FastForward1_Click" Padding="10,5" Margin="0,0,5,0"/><Button Content="+5 sec" Click="FastForward_Click" Padding="10,5"/></StackPanel></Grid>
     <Grid Grid.Row="2" Margin="4,14,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Jump to" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="TimeInput" Grid.Column="1" Text="00:00:00.00" Padding="8,6" Background="#10161F" Foreground="{StaticResource TextBrush}" BorderBrush="#2A3545" KeyDown="TimeInput_KeyDown"/><TextBlock Text="HH:MM:SS.frames" Grid.Column="2" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/><Button x:Name="ExportButton" Grid.Column="3" Content="Export PNG  →" Background="{StaticResource AccentDarkBrush}" Foreground="{StaticResource AccentBrush}" Click="Export_Click" IsEnabled="False"/></Grid>
    </Grid>
   </Border>
   <StackPanel Grid.Column="1">
    <TextBlock Text="VIDEO DETAILS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18"><StackPanel><TextBlock x:Name="FileNameText" Text="No video loaded" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="FilePathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/><WrapPanel><Border Background="#202B3A" CornerRadius="5" Padding="9,5" Margin="0,0,7,7"><TextBlock x:Name="ResolutionText" Text="Resolution —"/></Border><Border Background="#202B3A" CornerRadius="5" Padding="9,5" Margin="0,0,7,7"><TextBlock x:Name="CodecText" Text="Codec —"/></Border><Border Background="#202B3A" CornerRadius="5" Padding="9,5" Margin="0,0,7,7"><TextBlock x:Name="DepthText" Text="Color —"/></Border></WrapPanel><Border x:Name="HdrBadge" Background="#3A2C18" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="HdrText" Foreground="#FFCF76" FontWeight="SemiBold"/></Border><TextBlock x:Name="ColorText" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <TextBlock Text="EXPORT LOCATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,28,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14"><DockPanel LastChildFill="False"><TextBlock x:Name="FolderText" Text="Pictures\FrameGrabber" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Choose" DockPanel.Dock="Right" Click="Preferences_Click"/></DockPanel></Border>
    <TextBlock Text="FRAME QUEUE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,28,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Frames to export" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Grid.Column="1" Content="Import queue" Click="ImportQueue_Click" Padding="8,5" Margin="8,0,6,0"/><Button Grid.Column="2" Content="Save queue" Click="ExportQueue_Click" Padding="8,5"/></Grid><ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding}" Background="Transparent" BorderThickness="0" Margin="0,8,0,8"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Timecode, UpdateSourceTrigger=PropertyChanged}" Background="#10161F" Foreground="{StaticResource TextBrush}" BorderBrush="#2A3545" Padding="5"/><Button Grid.Column="1" Content="Preview" Tag="{Binding}" Click="QueuePreview_Click" Padding="7,4" Margin="5,0,3,0"/><Button Grid.Column="2" Content="↑" Tag="{Binding}" Click="QueueUp_Click" Padding="7,4" Margin="0,0,3,0"/><Button Grid.Column="3" Content="↓" Tag="{Binding}" Click="QueueDown_Click" Padding="7,4" Margin="0,0,3,0"/><Button Grid.Column="4" Content="×" Tag="{Binding}" Click="QueueRemove_Click" Padding="7,4"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><DockPanel Grid.Row="2"><Button Content="Add current frame" Click="AddQueue_Click" Background="{StaticResource AccentDarkBrush}" Foreground="{StaticResource AccentBrush}"/><Button Content="Export all PNGs" Click="ExportAll_Click" Background="{StaticResource AccentDarkBrush}" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" Padding="8,5" Margin="6,0,0,0"/><Button Content="Clear" Click="ClearQueue_Click" DockPanel.Dock="Right" Padding="8,5" Margin="6,0,0,0"/></DockPanel></Grid></Border>
   </StackPanel>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready — drop a video to begin" Foreground="{StaticResource MutedBrush}" Margin="2,20,0,0"/>
 </Grid>
</Window>
