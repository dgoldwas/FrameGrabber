<Window x:Class="FrameGrabber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrameGrabber"
        Icon="/FrameGrabber;component/assets/FrameGrabber.ico"
        Width="1180"
        Height="840"
        MinWidth="760"
        MinHeight="560"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="2,0,2,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="FRAMEGRABBER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="Precision stills from motion" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="Open video" Click="Browse_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" ToolTip="Open a video (Ctrl+O)" />
    </Grid>

    <ScrollViewer x:Name="BodyScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
      <Grid x:Name="ContentGrid" MinHeight="{Binding ViewportHeight, ElementName=BodyScroller}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SideColumn" Width="332" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition x:Name="StackRow" Height="0" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" MinHeight="440">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="DropZone" Background="{StaticResource StageBrush}" CornerRadius="12" ClipToBounds="True" MinHeight="220">
              <Grid>
                <Rectangle x:Name="DropOutline" Stroke="#3A4A60" StrokeThickness="1.5" StrokeDashArray="5 4" RadiusX="12" RadiusY="12" Margin="1" IsHitTestVisible="False" />
                <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                  <TextBlock Text="Drop a video here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="MKV, MP4, MOV, WebM and more" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                  <Button Content="Browse files" Click="Browse_Click" HorizontalAlignment="Center" ToolTip="Open a video (Ctrl+O)" />
                </StackPanel>
                <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border x:Name="PreviewMeta" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Background="#D10D1117" CornerRadius="8" Padding="10,6">
                  <TextBlock x:Name="PreviewTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </Border>
                <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#E60D1117" CornerRadius="12" IsHitTestVisible="False">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="Drop to open" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Release to load this video" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <StackPanel x:Name="TransportPanel" Grid.Row="1" Margin="2,14,2,0" IsEnabled="False">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeText" Text="00:00:00.00" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="112" />
                <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged" PreviewMouseLeftButtonUp="Timeline_PreviewMouseUp" ToolTip="Drag to scrub. Click the line to jump." />
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00.00" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="14" VerticalAlignment="Center" MinWidth="112" TextAlignment="Right" />
              </Grid>

              <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="−5s" Click="Rewind_Click" Margin="3" MinWidth="58" ToolTip="Back 5 seconds (Ctrl+Left)" />
                <Button Content="−1s" Click="Rewind1_Click" Margin="3" MinWidth="58" ToolTip="Back 1 second (Shift+Left)" />
                <Button Content="◀ Frame" Click="FrameBack_Click" Margin="3" ToolTip="Previous frame (Left)" />
                <Button Content="Frame ▶" Click="FrameForward_Click" Margin="3" ToolTip="Next frame (Right)" />
                <Button Content="+1s" Click="FastForward1_Click" Margin="3" MinWidth="58" ToolTip="Forward 1 second (Shift+Right)" />
                <Button Content="+5s" Click="FastForward_Click" Margin="3" MinWidth="58" ToolTip="Forward 5 seconds (Ctrl+Right)" />
              </WrapPanel>

              <Border x:Name="ChapterBar" Margin="0,12,0,0" Padding="8" Background="#10161F" CornerRadius="10" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Chapter" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,8,0" />
                  <Button Grid.Column="1" Content="Previous" Click="ChapterBack_Click" Padding="10,6" ToolTip="Go to the previous chapter" />
                  <ComboBox x:Name="ChapterPicker" Grid.Column="2" Margin="8,0" MinWidth="120" DisplayMemberPath="Title" SelectionChanged="ChapterPicker_SelectionChanged" ToolTip="Jump to a chapter" />
                  <Button Grid.Column="3" Content="Next" Click="ChapterForward_Click" Padding="10,6" ToolTip="Go to the next chapter" />
                </Grid>
              </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="2,14,2,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="158" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Jump to" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="TimeInput" Grid.Column="1" Text="00:00:00.00" KeyDown="TimeInput_KeyDown" ToolTip="HH:MM:SS.frames, or a number of seconds. Press Enter." />
              <Button Grid.Column="2" Content="Go" Click="Go_Click" Margin="8,0,0,0" MinWidth="52" ToolTip="Jump to this timecode (Enter)" />
              <Button x:Name="ExportButton" Grid.Column="4" Content="Export PNG" Style="{StaticResource PrimaryButton}" Click="Export_Click" IsEnabled="False" Margin="12,0,0,0" ToolTip="Save this frame as a full-resolution PNG (Ctrl+E)" />
            </Grid>

            <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Left / Right step a frame    ·    Shift ±1s    ·    Ctrl ±5s    ·    Ctrl+E export    ·    Ctrl+Enter add to queue" />
          </Grid>
        </Border>

        <Grid x:Name="SidePanel" Grid.Column="1" Margin="16,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="VIDEO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
              <StackPanel>
                <TextBlock x:Name="FileNameText" Text="No video loaded" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="FilePathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,4,0,14" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <WrapPanel>
                  <Border Background="{StaticResource ChipBrush}" CornerRadius="6" Padding="9,5" Margin="0,0,6,6">
                    <TextBlock x:Name="ResolutionText" Text="Resolution —" FontSize="12" />
                  </Border>
                  <Border Background="{StaticResource ChipBrush}" CornerRadius="6" Padding="9,5" Margin="0,0,6,6">
                    <TextBlock x:Name="CodecText" Text="Codec —" FontSize="12" />
                  </Border>
                  <Border Background="{StaticResource ChipBrush}" CornerRadius="6" Padding="9,5" Margin="0,0,6,6">
                    <TextBlock x:Name="DepthText" Text="Color —" FontSize="12" />
                  </Border>
                </WrapPanel>
                <Border x:Name="HdrBadge" Background="#3A2C18" CornerRadius="8" Padding="10,7" Margin="0,8,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="HdrText" Foreground="#FFCF76" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="ColorText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="EXPORT FOLDER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14">
              <StackPanel>
                <TextBlock Text="PNGs are saved here" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                <DockPanel>
                  <Button Content="Change" DockPanel.Dock="Right" Click="Preferences_Click" Margin="10,0,0,0" ToolTip="Choose the default export folder" />
                  <TextBlock x:Name="FolderText" Text="Pictures\FrameGrabber" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14" Margin="0,16,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="FRAME QUEUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock x:Name="QueueCountText" Text="0 frames" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Import" Click="ImportQueue_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Open a saved queue" />
                <Button Grid.Column="2" Content="Save" Click="ExportQueue_Click" Style="{StaticResource QuietButton}" Margin="6,0,0,0" ToolTip="Save this queue as JSON" />
              </Grid>
              <Grid Grid.Row="1" MinHeight="120" Margin="0,8,0,8">
                <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Timecode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Edit the timecode, then choose Show" />
                        <Button Grid.Column="1" Content="Show" Tag="{Binding}" Click="QueuePreview_Click" Margin="6,0,0,0" Padding="8,4" ToolTip="Preview this frame" />
                        <Button Grid.Column="2" Content="↑" Tag="{Binding}" Click="QueueUp_Click" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="Move up" />
                        <Button Grid.Column="3" Content="↓" Tag="{Binding}" Click="QueueDown_Click" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="Move down" />
                        <Button Grid.Column="4" Content="×" Tag="{Binding}" Click="QueueRemove_Click" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="Remove from queue" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="QueueEmpty" Text="Nothing queued yet. Find a frame, then add it." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False" />
              </Grid>
              <WrapPanel Grid.Row="2">
                <Button x:Name="AddQueueButton" Content="Add current frame" Click="AddQueue_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,4,6,0" ToolTip="Queue the frame you are previewing (Ctrl+Enter)" />
                <Button Content="Clear" Click="ClearQueue_Click" Style="{StaticResource QuietButton}" Margin="0,4,6,0" ToolTip="Remove every queued frame" />
                <Button x:Name="ExportAllButton" Content="Export all" Click="ExportAll_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,4,0,0" ToolTip="Save every queued frame as a PNG" />
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="2,14,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Drop a video anywhere, or choose Open video." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBlock Text="Developed by " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center">
          <Hyperlink NavigateUri="https://warmbutter.com" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource AccentBrush}">Warm Butter Design</Hyperlink>
        </TextBlock>
        <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center">
          <Hyperlink NavigateUri="https://github.com/dgoldwas/FrameGrabber" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource AccentBrush}">GitHub</Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
