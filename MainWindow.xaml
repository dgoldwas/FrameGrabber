<Window x:Class="FrameGrabber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FrameGrabber"
        Title="FrameGrabber"
        Icon="/FrameGrabber;component/assets/FrameGrabber.ico"
        Style="{StaticResource ThemedWindow}"
        Width="1240"
        Height="840"
        MinWidth="760"
        MinHeight="560"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid x:Name="Root" Background="{DynamicResource BaseBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>

    <!-- The window takes a little color from the current frame: a few pixels of it, stretched across everything. -->
    <Image x:Name="Backdrop" Grid.RowSpan="3" Stretch="Fill" Opacity="{DynamicResource BackdropOpacity}" RenderOptions.BitmapScalingMode="Linear" IsHitTestVisible="False" />

    <!-- The title bar: icon, menus, the open video, caption buttons. -->
    <Grid x:Name="TitleBar">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Path Margin="13,0,8,0" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
            StrokeLineJoin="Round"
            Data="M3,11 V19 A2,2 0 0 0 5,21 H17 M5,8 V16 A2,2 0 0 0 7,18 H19 M10,3 H19 A2,2 0 0 1 21,5 V12 A2,2 0 0 1 19,14 H10 A2,2 0 0 1 8,12 V5 A2,2 0 0 1 10,3 Z M10.5,11 L13.5,8 L16,10 L18,8.5" />
      <Menu x:Name="MenuBar" Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <MenuItem Header="_File">
          <MenuItem Header="_New" Command="{x:Static local:FrameCommands.New}" />
          <Separator />
          <MenuItem Header="_Open video…" Command="{x:Static local:FrameCommands.OpenVideo}" />
          <MenuItem Header="Open _queue…" Command="{x:Static local:FrameCommands.OpenQueue}" />
          <Separator />
          <MenuItem Header="_Save queue" Command="{x:Static local:FrameCommands.SaveQueue}" />
          <MenuItem Header="Save queue _as…" Command="{x:Static local:FrameCommands.SaveQueueAs}" />
          <Separator />
          <MenuItem Header="_Export this frame" Command="{x:Static local:FrameCommands.ExportFrame}" />
          <MenuItem Header="Export _all queued" Command="{x:Static local:FrameCommands.ExportAll}" />
          <MenuItem Header="Choose export _folder…" Command="{x:Static local:FrameCommands.ChooseFolder}" />
          <Separator />
          <MenuItem Header="_Close project" Command="{x:Static local:FrameCommands.CloseProject}" />
          <MenuItem Header="E_xit" Command="{x:Static local:FrameCommands.Exit}" />
        </MenuItem>
        <MenuItem x:Name="EditMenu" Header="_Edit" SubmenuOpened="EditMenu_SubmenuOpened">
          <MenuItem x:Name="UndoMenuItem" Header="_Undo" Command="{x:Static local:FrameCommands.Undo}" />
          <MenuItem x:Name="RedoMenuItem" Header="_Redo" Command="{x:Static local:FrameCommands.Redo}" />
          <Separator />
          <MenuItem Header="_Add this frame to the queue" Command="{x:Static local:FrameCommands.AddFrame}" />
          <MenuItem Header="Re_move from the queue" Command="{x:Static local:FrameCommands.RemoveFrame}" />
          <MenuItem Header="C_lear the queue" Command="{x:Static local:FrameCommands.ClearQueue}" />
          <Separator />
          <MenuItem Header="_Copy frame" Command="{x:Static local:FrameCommands.CopyFrame}" />
          <MenuItem Header="Copy _timecode" Command="{x:Static local:FrameCommands.CopyTimecode}" />
          <Separator />
          <MenuItem Header="_Settings…" Command="{x:Static local:FrameCommands.Settings}" />
        </MenuItem>
        <MenuItem Header="_Navigate">
          <MenuItem Header="_Go to timecode…" Command="{x:Static local:FrameCommands.GoToTimecode}" />
          <Separator />
          <MenuItem Header="_Previous frame" Command="{x:Static local:FrameCommands.PreviousFrame}" InputGestureText="Left" />
          <MenuItem Header="_Next frame" Command="{x:Static local:FrameCommands.NextFrame}" InputGestureText="Right" />
          <MenuItem Header="_Back 1 second" Command="{x:Static local:FrameCommands.Back1}" InputGestureText="Shift+Left" />
          <MenuItem Header="_Forward 1 second" Command="{x:Static local:FrameCommands.Forward1}" InputGestureText="Shift+Right" />
          <MenuItem Header="Back _5 seconds" Command="{x:Static local:FrameCommands.Back5}" InputGestureText="Ctrl+Left" />
          <MenuItem Header="Forward 5 s_econds" Command="{x:Static local:FrameCommands.Forward5}" InputGestureText="Ctrl+Right" />
          <Separator />
          <MenuItem Header="Previous _chapter" Command="{x:Static local:FrameCommands.PreviousChapter}" InputGestureText="PgUp" />
          <MenuItem Header="Next c_hapter" Command="{x:Static local:FrameCommands.NextChapter}" InputGestureText="PgDn" />
        </MenuItem>
        <MenuItem x:Name="HelpMenu" Header="_Help">
          <MenuItem Header="_Keyboard shortcuts" Command="{x:Static local:FrameCommands.Shortcuts}" />
          <Separator />
          <MenuItem x:Name="UpdateMenuItem" Header="Check for _updates" Click="UpdateMenuItem_Click" />
          <MenuItem x:Name="AboutMenuItem" Header="_About FrameGrabber" Click="About_Click" />
        </MenuItem>
      </Menu>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
        <TextBlock x:Name="TitleName" Text="FrameGrabber" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="TitleMeta" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize" ToolTip="Minimize">
          <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
        </Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize">
          <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" AutomationProperties.Name="Close" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer x:Name="BodyScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
      <Grid x:Name="ContentGrid" Margin="14,6,14,0" MinHeight="{Binding ViewportHeight, ElementName=BodyScroller}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SideColumn" Width="356" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition x:Name="StackRow" Height="0" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassPanel}" Padding="12" MinHeight="440">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The stage stays dark in both themes, so what is drawn on it has fixed light colors. -->
            <Border x:Name="DropZone" Background="{DynamicResource StageBrush}" CornerRadius="10" ClipToBounds="True" MinHeight="220">
              <Grid>
                <Rectangle x:Name="DropOutline" Stroke="#3D4552" StrokeThickness="1.5" StrokeDashArray="5 4" RadiusX="10" RadiusY="10" Margin="1" IsHitTestVisible="False" />
                <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                  <TextBlock Text="Drop a video here" FontSize="22" FontWeight="SemiBold" Foreground="#F2F4F8" HorizontalAlignment="Center" />
                  <TextBlock Text="MKV, MP4, MOV, WebM and more" Foreground="#A6AEBD" Margin="0,8,0,16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                  <Button Content="Browse files" Command="{x:Static local:FrameCommands.OpenVideo}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" ToolTip="Open a video (Ctrl+O)" />
                </StackPanel>
                <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel x:Name="PreviewMeta" Orientation="Horizontal" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                  <Border Background="#B80D1117" CornerRadius="7" Padding="9,5">
                    <TextBlock x:Name="PreviewTitle" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="#F2F4F8" />
                  </Border>
                  <Border x:Name="PreviewHdrTag" Background="#B80D1117" CornerRadius="7" Padding="9,5" Margin="6,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="PreviewHdrText" FontSize="11" FontWeight="Bold" Foreground="#FFCF76" />
                  </Border>
                </StackPanel>
                <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#E60D0F13" CornerRadius="10" IsHitTestVisible="False">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="Drop to open" FontSize="22" FontWeight="SemiBold" Foreground="#F2F4F8" HorizontalAlignment="Center" />
                    <TextBlock Text="Release to load this video" Foreground="#A6AEBD" Margin="0,6,0,0" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <StackPanel x:Name="TransportPanel" Grid.Row="1" IsEnabled="False">
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeText" Text="00:00:00.00" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="100" />
                <Grid Grid.Column="1" Margin="10,0">
                  <Slider x:Name="Timeline" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged" PreviewMouseLeftButtonUp="Timeline_PreviewMouseUp" ToolTip="Drag to scrub. Click the line to jump." />
                  <!-- Chapter starts as ticks, queued frames as diamonds. -->
                  <Canvas x:Name="TimelineMarks" IsHitTestVisible="False" ClipToBounds="False" />
                </Grid>
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00.00" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalAlignment="Center" MinWidth="100" TextAlignment="Right" />
              </Grid>
              <Grid Margin="110,0,110,0">
                <TextBlock x:Name="ChapterNameText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="QueueLegend" Text="◆ queued frame" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Visibility="Collapsed" />
              </Grid>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                  <Border Style="{StaticResource SegmentGroup}" Margin="0,0,10,4">
                    <StackPanel Orientation="Horizontal">
                      <Button Content="−5s" Command="{x:Static local:FrameCommands.Back5}" Style="{StaticResource SegmentButton}" ToolTip="Back 5 seconds (Ctrl+Left)" />
                      <Button Content="−1s" Command="{x:Static local:FrameCommands.Back1}" Style="{StaticResource SegmentButton}" ToolTip="Back 1 second (Shift+Left)" />
                      <Button Command="{x:Static local:FrameCommands.PreviousFrame}" Style="{StaticResource SegmentButton}" ToolTip="Previous frame (Left)">
                        <StackPanel Orientation="Horizontal">
                          <Path Style="{StaticResource Icon}" Data="M15,6 L9,12 L15,18" Margin="0,0,5,0" />
                          <TextBlock Text="Frame" />
                        </StackPanel>
                      </Button>
                      <Button Command="{x:Static local:FrameCommands.NextFrame}" Style="{StaticResource SegmentButton}" ToolTip="Next frame (Right)">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Frame" />
                          <Path Style="{StaticResource Icon}" Data="M9,6 L15,12 L9,18" Margin="5,0,0,0" />
                        </StackPanel>
                      </Button>
                      <Button Content="+1s" Command="{x:Static local:FrameCommands.Forward1}" Style="{StaticResource SegmentButton}" ToolTip="Forward 1 second (Shift+Right)" />
                      <Button Content="+5s" Command="{x:Static local:FrameCommands.Forward5}" Style="{StaticResource SegmentButton}" ToolTip="Forward 5 seconds (Ctrl+Right)" />
                    </StackPanel>
                  </Border>
                  <Border x:Name="ChapterBar" Style="{StaticResource SegmentGroup}" Margin="0,0,10,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                      <Button Command="{x:Static local:FrameCommands.PreviousChapter}" Style="{StaticResource SegmentButton}" Padding="8,0" ToolTip="Previous chapter (PgUp)">
                        <Path Style="{StaticResource Icon}" Data="M17,6 L11,12 L17,18 M7,6 V18" />
                      </Button>
                      <ComboBox x:Name="ChapterPicker" MinWidth="128" MaxWidth="240" DisplayMemberPath="Title" SelectionChanged="ChapterPicker_SelectionChanged" ToolTip="Jump to a chapter" />
                      <Button Command="{x:Static local:FrameCommands.NextChapter}" Style="{StaticResource SegmentButton}" Padding="8,0" ToolTip="Next chapter (PgDn)">
                        <Path Style="{StaticResource Icon}" Data="M7,6 L13,12 L7,18 M17,6 V18" />
                      </Button>
                    </StackPanel>
                  </Border>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <TextBlock Text="Jump to" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox x:Name="TimeInput" Width="124" Text="00:00:00.00" KeyDown="TimeInput_KeyDown" ToolTip="HH:MM:SS.frames, or a number of seconds. Press Enter. (Ctrl+G)" />
                  <Button Content="Go" Click="Go_Click" Margin="8,0,0,0" ToolTip="Jump to this timecode (Enter)" />
                  <Button x:Name="AddQueueButton" Command="{x:Static local:FrameCommands.AddFrame}" Margin="8,0,0,0" ToolTip="Queue the frame you are previewing (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource Icon}" Data="M12,5 V19 M5,12 H19" Margin="0,0,6,0" />
                      <TextBlock Text="Queue" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="ExportButton" Command="{x:Static local:FrameCommands.ExportFrame}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="Save this frame as a full-resolution PNG (Ctrl+E)">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource Icon}" Data="M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19" Margin="0,0,6,0" />
                      <TextBlock Text="Export PNG" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Grid x:Name="SidePanel" Grid.Column="1" Margin="14,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource GlassPanel}" Padding="16,14">
            <StackPanel>
              <TextBlock Text="VIDEO" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
              <TextBlock x:Name="FileNameText" Text="No video loaded" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="FilePathText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,10" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <WrapPanel x:Name="VideoChips" Visibility="Collapsed">
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="ResolutionText" FontSize="12" /></Border>
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="CodecText" FontSize="12" /></Border>
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="DepthText" FontSize="12" /></Border>
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="FpsText" FontSize="12" /></Border>
              </WrapPanel>
              <Border x:Name="HdrBadge" Background="#1FF5C451" BorderBrush="#47F5C451" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,4,0,0" Visibility="Collapsed">
                <DockPanel>
                  <Ellipse Width="8" Height="8" Fill="#F5C451" VerticalAlignment="Top" Margin="0,5,8,0" />
                  <TextBlock x:Name="HdrText" FontSize="12.5" TextWrapping="Wrap" />
                </DockPanel>
              </Border>
              <TextBlock x:Name="ColorText" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
              <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,12,0,8" />
              <DockPanel>
                <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0"
                      Data="M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z" />
                <Button DockPanel.Dock="Right" Content="Change" Command="{x:Static local:FrameCommands.ChooseFolder}" Style="{StaticResource QuietButton}" Height="28" ToolTip="Choose the export folder" />
                <TextBlock x:Name="FolderText" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="10,14,10,12" Margin="0,14,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                <TextBlock Text="FRAME QUEUE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                <TextBlock x:Name="QueueCountText" Text="0 frames" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Grid Grid.Row="1" MinHeight="120" Margin="0,0,0,8">
                <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:QueueItem}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="32" CornerRadius="6" Background="{DynamicResource StageBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,6,0">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBox Text="{Binding Timecode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTimecode}" GotKeyboardFocus="QueueTimecode_GotFocus" LostKeyboardFocus="QueueTimecode_LostFocus" KeyDown="QueueTimecode_KeyDown" ToolTip="Edit the timecode, then press Enter to show it" />
                          <TextBlock x:Name="Chapter" Text="{Binding Chapter}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Tag="{Binding}" Click="QueuePreview_Click" Style="{StaticResource IconButton}" ToolTip="Show this frame">
                          <Path Style="{StaticResource Icon}" Data="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z" />
                        </Button>
                        <Button Grid.Column="3" Tag="{Binding}" Click="QueueRemove_Click" Style="{StaticResource IconButton}" ToolTip="Remove from the queue (Del)">
                          <Path Style="{StaticResource Icon}" Data="M6,6 L18,18 M18,6 L6,18" />
                        </Button>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Chapter}" Value="">
                          <Setter TargetName="Chapter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="QueueEmpty" Text="Nothing queued yet. Find a frame, then add it with Queue or Ctrl+Enter." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False" />
              </Grid>
              <DockPanel Grid.Row="2" Margin="6,0" LastChildFill="False">
                <Button Content="Clear" Command="{x:Static local:FrameCommands.ClearQueue}" Style="{StaticResource QuietButton}" ToolTip="Remove every queued frame" />
                <Button x:Name="ExportAllButton" DockPanel.Dock="Right" Content="Export all" Command="{x:Static local:FrameCommands.ExportAll}" Style="{StaticResource PrimaryButton}" ToolTip="Save every queued frame as a PNG (Ctrl+Shift+E)" />
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="Drop a video anywhere, or choose File › Open video." Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <TextBlock Text="Developed by " Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" FontSize="12">
          <Hyperlink NavigateUri="https://warmbutter.com" RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource AccentInkBrush}">Warm Butter Design</Hyperlink>
        </TextBlock>
        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" FontSize="12">
          <Hyperlink NavigateUri="https://github.com/dgoldwas/FrameGrabber" RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource AccentInkBrush}">GitHub</Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
